# Stage 1: Compile the simulator API.
FROM golang:1.27.2-alpine AS builder
WORKDIR /src
COPY go.mod ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -buildvcs=false -ldflags="-s -w" -o /out/simulator ./cmd/app/simulator

# Stage 2: Build the simulator runtime image.
FROM alpine:3.24 AS simulator
RUN apk add --no-cache ca-certificates
WORKDIR /app
COPY --from=builder /out/simulator ./simulator
EXPOSE 8080
USER 10001:10001
ENTRYPOINT ["./simulator"]


# Stage 3: Compile the digital twin backend.
FROM builder AS digitaltwin-builder
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -buildvcs=false -ldflags="-s -w" -o /out/digitaltwin ./cmd/app/digitaltwin

# Stage 4: Build the digital twin runtime image.
FROM alpine:3.24 AS digitaltwin
RUN apk add --no-cache ca-certificates
WORKDIR /app
COPY --from=digitaltwin-builder /out/digitaltwin ./digitaltwin
EXPOSE 8080
USER 10001:10001
ENTRYPOINT ["./digitaltwin"]